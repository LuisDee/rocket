{
  "name": "rocket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node src/db/seed.mts",
    "db:export": "node src/db/export.mts",
    "probe:g1": "node scripts/probe-g1.mts",
    "test:watch": "vitest",
    "guards": "python3 scripts/check_gate_ledger.py && python3 scripts/test_guards.py && python3 scripts/check_no_strava_api.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vercel/functions": "3.9.5",
    "drizzle-orm": "0.45.2",
    "mcp-handler": "1.1.0",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "mcp-handler": {
      "@modelcontextprotocol/sdk": "1.29.0"
    }
  }
}
