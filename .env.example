# Names only. Never values -- REDLINES.md rule 5: no secret in source, ever,
# including example config. The real values live in `pass`:
#
#   DATABASE_URL           pass show neon/database-url
#   DATABASE_URL_UNPOOLED  pass show neon/database-url-unpooled
#
# TWO URLs, and mixing them up is the classic failure:
#   DATABASE_URL           pooled (-pooler host)  -- the app, the seeder, the
#                                                    export, the tests
#   DATABASE_URL_UNPOOLED  direct host            -- MIGRATIONS ONLY. PgBouncer
#                                                    transaction mode cannot run
#                                                    the session-level operations
#                                                    a migration needs.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The application role `app_rw` is created NOLOGIN by
# src/db/migrations/0001_append_only_guards.sql, deliberately: a committed
# migration must never generate a credential. At deploy time, give it one and
# point the app at it instead of the owner:
#
#   ALTER ROLE app_rw LOGIN PASSWORD '<generated at deploy time>';
#
# Until then the app connects as the table owner and the grant layer is
# exercised in tests via SET LOCAL ROLE.

# Where `npm run db:export` writes. Defaults to ./backups, which is gitignored.
ROCKET_BACKUP_DIR=
