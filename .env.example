# Names only. Never values -- REDLINES.md rule 5: no secret in source, ever,
# including example config. The real values live in `pass`:
#
#   DATABASE_URL           pass show neon/database-url
#   DATABASE_URL_UNPOOLED  pass show neon/database-url-unpooled
#
# TWO URLs, and mixing them up is the classic failure:
#   DATABASE_URL           pooled (-pooler host)  -- the app, the seeder, the
#                                                    export, the tests
#   DATABASE_URL_UNPOOLED  direct host            -- MIGRATIONS ONLY. PgBouncer
#                                                    transaction mode cannot run
#                                                    the session-level operations
#                                                    a migration needs.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The application role `app_rw` is created NOLOGIN by
# src/db/migrations/0001_append_only_guards.sql, deliberately: a committed
# migration must never generate a credential. At deploy time, give it one and
# point the app at it instead of the owner:
#
#   ALTER ROLE app_rw LOGIN PASSWORD '<generated at deploy time>';
#
# Until then the app connects as the table owner and the grant layer is
# exercised in tests via SET LOCAL ROLE.

# Where `npm run db:export` writes. Defaults to ./backups, which is gitignored.
ROCKET_BACKUP_DIR=

# The MCP endpoint's shared secret. NAME ONLY -- REDLINES.md rule 5.
#
# The endpoint at /api/mcp/mcp is an internet-reachable write surface into an
# append-only history, and this is its only gate. Unset means nothing
# authenticates and the surface is dormant, which is the fail-closed default.
#
# Use a URL-SAFE token (hex or base64url): claude.ai's custom-connector UI has
# no header field, so the secret rides in the URL as ?token=, and a base64
# secret containing + / or = breaks on paste -- `+` decodes to a space in a
# query string. Generate with `openssl rand -hex 32` and store it in pass.
MCP_BEARER_TOKEN=

# --------------------------------------------------------- the daily pass ---

# The intervals.icu bridge. NAMES ONLY -- REDLINES.md rule 5.
#
# intervals.icu is the primary Garmin path (decided 2026-09-07,
# docs/specs/05-integrations.md). It holds genuine Garmin partner OAuth, relays
# wellness within minutes of a watch sync, and carries the outbound calendar
# push that puts the plan on the Fenix 8 -- one credential for both legs.
#
#   1. intervals.icu -> Settings -> connect Garmin, wait one sync cycle
#   2. Settings -> Developer Settings -> generate an API key
#   3. the athlete id is the number in your intervals.icu URL, e.g. i123456
#
# With either unset the bridge is unconfigured, the daily pass reports a FAILED
# run naming these two variables, and the dead-man's switch is not pinged --
# deliberately loud. Manual logging and check-ins are unaffected (spec
# invariant 2).
#
# Run Decision gate G1 before anything leans on a wellness field:
#   INTERVALS_API_KEY=... INTERVALS_ATHLETE_ID=... npm run probe:g1
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# The daily cron's shared secret. NAME ONLY.
#
# Vercel Cron presents it as `Authorization: Bearer $CRON_SECRET` against
# /api/cron/daily. Unset means nothing authenticates and the route is dormant,
# which is the fail-closed default -- it writes into an append-only history and
# pushes to the athlete's own watch calendar. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# The dead-man's switch. NAME ONLY.
#
# A healthchecks.io ping URL, hit ONLY as the final step of a SUCCESSFUL daily
# pass. Its ABSENCE is the alarm: this is the only layer that can detect "the
# job never ran at all", which a row in our own database is blind to by
# construction, and it is what makes Vercel Hobby cron's best-effort delivery
# (about an hour late, never retried, missable with no log) harmless.
#
# Set the check's period to 1 day and its grace to 2 hours. Unset means no ping,
# which is right in development and is reported in the pass result rather than
# swallowed.
HEALTHCHECK_PING_URL=
