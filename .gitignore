# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the one that carries variable NAMES and no values. REDLINES.md
# rule 5 bans secrets in source; it does not ban documenting what to set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# feature worktrees (Worktree Mandate)
/.worktrees/

# python guard bytecode
__pycache__/
*.pyc
# python harness venvs and probe output (health data + live tokens)
tools/**/.venv/
tools/**/out/

# database exports: real training history and check-ins, never committed
/backups/

# Activity files are GPS traces of real runs. Never commit one.
*.fit
*.FIT

# Viewport sweep: its own build output and Playwright artefacts
.next-e2e/
test-results/
playwright-report/
